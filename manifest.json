{
  "manifest_version": 3,
  "name": "CurrentVibe",
  "version": "1.0.1",
  "description": "GitHub Trending in your Whale sidebar, with analyze-first AI prompts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "sidebar_action": {
    "default_page": "sidebar.html",
    "default_title": "CurrentVibe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
